generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid())
  fullName             String
  email                String        @unique
  passwordHash         String
  role                 UserRole      @default(STUDENT)
  status               AccountStatus @default(ACTIVE)
  emailVerified        Boolean       @default(false)
  avatarUrl            String?
  headline             String?
  location             String?
  bio                  String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  passwordResetToken   String?
  passwordResetExpires DateTime?
  verificationToken    String?
  lastLoginAt          DateTime?

  @@index([role, status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

enum UserRole {
  ADMIN
  STUDENT
  JOB_SEEKER
  EMPLOYER
  MENTOR
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
